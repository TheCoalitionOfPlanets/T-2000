# Optional overrides for `docker compose up -d --build`. Every value has a
# working default; copy to .env only to change one.

# Host port for the studio UI.
#T2000_PORT=7861

# t1000-mf2 (fast, two sampling steps) or t1000-soar (higher quality, ten steps).
#T2000_BACKEND=t1000-mf2

# high-vram: dense BF16 language model, upstream sequence limits. Needs ~8 GB
# of VRAM or more and is the default. Use low-vram only for smaller cards; it
# also requires bitsandbytes, which the default image does not install.
#T2000_T1000_PROFILE=high-vram

#T2000_TTS_DEVICE=cuda:0
#T2000_NUM_THREADS=8

# Set to 1 to start strictly offline against already-downloaded models.
#T2000_SKIP_MODEL_FETCH=0
