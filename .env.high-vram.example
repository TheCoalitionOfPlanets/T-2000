# Optional overrides for `docker compose -f compose.high-vram.yaml up -d --build`.
# On the 16 GB host, copy this to .env only to change the defaults.

# Host port for the studio UI.
#T2000_PORT=7861

# t1000-mf2 (two sampling steps, fast) or t1000-soar (ten steps, higher quality).
#T2000_BACKEND=t1000-mf2

#T2000_TTS_DEVICE=cuda:0
#T2000_NUM_THREADS=8

# Container network MTU. 1280 is the safe default because a VPN interface
# (Tailscale, for one) lowers the host uplink to 1280, and a container MTU
# above the uplink makes large transfers collapse. Set 1500 if the whole
# network path is known to be 1500.
#T2000_MTU=1280

# Set to 1 to start strictly offline against already-downloaded models.
#T2000_SKIP_MODEL_FETCH=0
